# Database
MONGODB_URI=your_mongodb_connection_string

# Google Gemini API (for image generation)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter API (for text/thinking tasks - Kimi K2)
OPENROUTER_API_KEY=your_openrouter_api_key

# AWS S3
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# JWT
JWT_SECRET=your_jwt_secret_key

# Instagram OAuth (using Instagram Graph API)
# Create app at: https://developers.facebook.com/
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5173/instagram/callback

# Node Environment
NODE_ENV=development
# --- LinkedIn ---
# Create an app at https://www.linkedin.com/developers/apps and add the products:
#   "Sign In with LinkedIn using OpenID Connect" (grants openid/profile/email)
#   "Share on LinkedIn"                          (grants w_member_social)
# Both are self-serve. Company-page posting additionally needs the
# "Community Management API" product, which LinkedIn reviews manually - set
# LINKEDIN_ENABLE_ORG=true only after that review is approved.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.velosapps.com/linkedin/callback
# LinkedIn-Version header, YYYYMM. LinkedIn ships a version monthly and
# supports each for one year, so this needs bumping periodically.
LINKEDIN_API_VERSION=202608
LINKEDIN_ENABLE_ORG=false

# --- X (Twitter) ---
# Create an app at https://developer.x.com/en/portal/dashboard, enable
# "User authentication settings" -> OAuth 2.0, type "Web App", with
# App permissions = Read and write.
# Note the access tiers: Free allows 500 posts/month and only 17 media
# initialize/finalize calls per 24h, which is the real constraint on an
# image or video autopilot. Basic ($200/mo) raises both.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://www.velosapps.com/twitter/callback

# --- Local development ---
# Skip the background workers (scheduler publishing, autopilot, media jobs).
# Set this whenever you run against the production database from a laptop -
# otherwise your local process competes with the deployed server to publish
# due posts, and can post the same thing twice to a real account.
DISABLE_CRONS=false

# Motion Studio: standalone API/worker or integrated /api/motion route.
# Local development uses `npm run motion:dev` with isolated files, not MONGO_URL.
MOTION_PUBLIC_API_URL=https://api.example.com/api/motion
MOTION_FRONTEND_ORIGIN=https://studio.example.com
MOTION_PORT=4701
MOTION_STORAGE=s3
MOTION_DATA_DIR=/var/lib/velos-motion
MOTION_DAILY_SECONDS=300
# Loopback motion:dev only; production AI limit remains 30.
MOTION_LOCAL_AI_LIMIT=30
# Optional loopback frontend port when another project occupies 5173.
MOTION_FRONTEND_PORT=5173
# Isolated procedural graphics renderer; build with npm run motion:python:build.
MOTION_PYTHON_IMAGE=velos-motion-python:local
# MOTION_DOCKER=/usr/local/bin/docker
MOTION_RENDER_CONCURRENCY=2
MOTION_INLINE_WORKER=false
MOTION_LLM_MODEL=google/gemini-3.8-flash
# OPENROUTER_API_KEY enables design. OPENAI_API_KEY optionally enables captions.
# MOTION_FFPROBE=/usr/bin/ffprobe
