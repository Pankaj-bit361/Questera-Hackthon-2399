{
  "name": "quest-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "motion:dev": "node Questera-Backend/motion/dev.cjs",
    "motion:proof": "node motion/proof.mjs",
    "motion:test": "node --test tests/motion.test.mjs tests/motion-mongo.test.mjs tests/motion-creative.test.mjs tests/motion-automatic.test.mjs tests/motion-prompt-video.test.mjs",
    "motion:python:build": "docker build -t velos-motion-python:local motion/python-engine",
    "motion:prompt:proof": "node motion/prompt-video-proof.mjs",
    "motion:worker": "node Questera-Backend/motion/serve-worker.cjs",
    "motion:api": "node Questera-Backend/motion/serve-api.cjs",
    "studio:dev": "node Questera-Backend/studio/dev.cjs",
    "studio:music": "python3 studio/audio/stems.py",
    "studio:test": "node --test tests/studio.test.mjs",
    "velos:test": "node --test --test-timeout=240000 tests/velos-*.test.mjs",
    "velos:eval": "node scripts/eval-velos.mjs",
    "studio:deploy": "deploy/studio/deploy.sh"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/player": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.16.1",
    "framer-motion": "^11.0.8",
    "lenis": "^1.3.16",
    "lucide-react": "^0.562.0",
    "puppeteer-core": "^25.12.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.0.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.0",
    "react-toastify": "9.1.3",
    "remotion": "4.0.530",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "mongodb-memory-server": "^10.2.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "6.4.3"
  }
}
